# All values are optional; these are the defaults.
MICROSCORE_MLFLOW_URI=sqlite:///mlflow/mlflow.db
MICROSCORE_MODEL_NAME=microscore-credit
MICROSCORE_CHAMPION_ALIAS=champion
MICROSCORE_CHALLENGER_ALIAS=challenger
# cpp | lightgbm | onnx
MICROSCORE_ENGINE=cpp
MICROSCORE_N_THREADS=1
MICROSCORE_SHADOW_ENABLED=1
MICROSCORE_SHADOW_DB=data/shadow.db
MICROSCORE_SHADOW_LOG_FEATURES=1
# Train + register demo champion/challenger models on first start if the registry is empty
MICROSCORE_AUTO_SEED=1
MICROSCORE_APPROVE_BELOW=0.10
MICROSCORE_DECLINE_ABOVE=0.25
